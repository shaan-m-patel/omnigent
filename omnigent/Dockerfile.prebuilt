# Railway build for the personal-agent-os fork.
#
# This extends the official prebuilt server image (which already contains the
# web UI bundle that a source build can't produce) and layers in Shaan's
# custom agent + MCP server configs. The server auto-discovers the agent from
# /opt/omnigent/agents/shaan-assistant/config.yaml and its MCP servers from
# tools/mcp/ (omnigent/spec/parser.py:_discover_mcp_servers).
#
# Deploy: Railway reads railway.toml (builder=DOCKERFILE,
# dockerfilePath=omnigent/Dockerfile.prebuilt) from the shaan-m-patel/omnigent
# fork. Pair with the Railway Postgres plugin (DATABASE_URL auto-injected).
#
# Required Railway Variables for this agent to run:
#   OPENAI_API_KEY     - already set; powers the openai-agents harness (model gpt-4o)
#   MEM0_API_KEY       - already set (Mem0 Cloud memory layer)
#   GITHUB_TOKEN       - your "PersonalAgent" PAT (read scopes: Contents/Issues/PRs);
#                        GitHub's remote MCP accepts a PAT Bearer header (confirmed).
#                        Add to Railway Variables when ready; GitHub MCP tools come online then.
#
# Optional (V2): mount a Railway Volume at /data/artifacts for persistent
# artifact storage across redeploys.

ARG OMNIGENT_IMAGE=ghcr.io/omnigent-ai/omnigent-server:latest
FROM ${OMNIGENT_IMAGE}

# Layer in the custom agent + MCP server configs. Build context is the repo root,
# so the COPY source is omnigent/agents/shaan-assistant (not agents/shaan-assistant).
COPY omnigent/agents/shaan-assistant /opt/omnigent/agents/shaan-assistant

# Tell the server where global config + agents live.
ENV OMNIGENT_CONFIG_HOME=/opt/omnigent
